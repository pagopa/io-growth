meta {
  name: Create a test session (test users only)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/test-session
  body: json
  auth: none
}

body:json {
  {
    "fiscalCode": "{{fiscalCode}}",
    "familyName": "{{name}}",
    "givenName": "{{surname}}"
  }
}

script:post-response {
  if (res.status === 200) {  
    bru.setEnvVar("sessionToken", res.body.token, { persist: false });
  }
}
