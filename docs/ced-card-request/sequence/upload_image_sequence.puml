@startuml Upload Image Sequence Diagram

actor "FE (User App)" as FE
participant "BFF (Our System)" as BFF
database "Local DB\n(partitionKey, idLavorazione,\nstate, pendingStep, steps{})" as DB
box "INPS Services (PDND)" #LightBlue
  participant "MS INPS\n(GestioneDomandaCED)" as INPS
end box

title 3. Photo Submission (FornisciFoto)

FE -> BFF: POST /image (idLavorazione, fotoCED)\n<<Header: Idempotency-Key = clientKey>>

BFF -> DB: Read Record R (partitionKey = CF)
DB --> BFF: R
BFF -> BFF: Verify R.idLavorazione == idLavorazione (ownership)

alt Replay/retry of the SAME intent (R.steps.photo.clientRequestId == clientKey)
    alt R.steps.photo.status == COMPLETED
        note right of BFF: True replay, no INPS call.
        BFF --> FE: 200 (Next step: Confirmation)
    else status PENDING/FAILED
        note right of BFF: Retry reuses R.steps.photo.inpsIdempotencyKey (IK_PHOTO).
    end

else NEW intent (new clientKey -> change/replace photo)
    BFF -> BFF: Generate IK_PHOTO (UUID)
    note right of BFF: Cascade rule: reset confirm step.\nidLavorazione is unchanged (FornisciFoto overwrites the photo).

    == Write 1: intent record ==
    BFF -> DB: UPDATE R (steps.photo={clientRequestId:clientKey,\ninpsIdempotencyKey:IK_PHOTO, status:PENDING}, pendingStep:PHOTO) <<If-Match>>
    alt DB Write 1 FAILURE
        DB --> BFF: ERROR
        BFF --> FE: 503 Service Unavailable
    end
    DB --> BFF: OK
end

BFF -> INPS: FornisciFoto(idLavorazione, fotoCED)\n<<Header: Idempotency-Key = IK_PHOTO>>

alt INPS Success (HTTP 200 OK)
    INPS --> BFF: idLavorazione (X)

    == Write 2: outcome ==
    BFF -> DB: UPDATE R (steps.photo.status=COMPLETED,\nstate=READY_FOR_DOCUMENTS_UPLOAD, pendingStep=NULL) <<If-Match>>

    alt DB Update SUCCESS
        DB --> BFF: OK
        BFF --> FE: 200 (Next step: Confirmation required)
    else DB Update FAILURE (***INCONSISTENCY POINT***)
        DB --> BFF: ERROR (Timeout)
        note right of BFF: INPS confirmed photo (esitoCheck=30); local still PENDING.\nReconciliation on next /status realigns.
        BFF --> FE: 500 System Error
    end

else INPS Failure (HTTP 400)
    INPS --> BFF: Error Code (900-911 photo, 115 state)
    BFF -> DB: UPDATE R (steps.photo.status=FAILED, lastErrorCode, pendingStep=NULL)
    DB --> BFF: OK
    BFF --> FE: 400 Validation Error: photo must be re-submitted (code)

else INPS System Error (HTTP 500)
    INPS --> BFF: Error Code 100
    note right of BFF: Keep steps.photo.status=PENDING so a retry reuses IK_PHOTO.
    BFF --> FE: 500 System Error
end
@enduml
