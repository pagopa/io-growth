server {
    listen 8080;
    server_name _;

    location /healthz {
        access_log off;
        return 200 'ok';
        add_header Content-Type text/plain;
    }

    location / {
        proxy_pass                  https://${INPS_UPSTREAM};
        proxy_set_header            Host ${INPS_UPSTREAM};

        # TLS to upstream
        proxy_ssl_server_name       on;
        proxy_ssl_protocols         TLSv1.2 TLSv1.3;
        proxy_ssl_verify            on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

        proxy_http_version          1.1;
        proxy_set_header            Connection "";

        # Preserve all incoming headers unchanged (Agid-JWT-Signature,
        # INPS-Identity-UserId, INPS-Identity-CodiceUfficio, Digest, etc.)
        proxy_pass_request_headers  on;

        # Generous timeout for INPS API round-trips
        proxy_connect_timeout       10s;
        proxy_read_timeout          60s;
        proxy_send_timeout          60s;
    }
}
