meta {
  name: Assertion Consumer Service callback
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/acs
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("sessionId", res.body.sessionId, { persist: false });
  }
}
