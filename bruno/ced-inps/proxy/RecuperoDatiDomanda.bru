meta {
  name: RecuperoDatiDomanda
  type: http
  seq: 5
}

post {
  url: {{inpsProxyBaseUrl}}/Domanda/RecuperoDatiDomanda
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  INPS-Identity-UserId: {{fiscalCode}}
  INPS-Identity-CodiceUfficio: {{inpsOfficeCode}}
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "idLavorazione": "{{processingId}}",
    "codiceFiscale": "{{fiscalCode}}"
  }
}

script:post-response {
  if (res.status >= 200 && res.status < 300) {
    const photo = res.body?.fotoCED;

    if (typeof photo !== "string" || photo.length === 0) {
      bru.visualize("html", {
        name: "Foto CED",
        content: "<p>Nessuna foto presente nella risposta.</p>"
      });
    } else {
      const photoBase64 = photo.replace(/^data:image\/[^;]+;base64,/, "");
      const imageMimeType = photoBase64.startsWith("iVBORw0KGgo")
        ? "image/png"
        : photoBase64.startsWith("/9j/")
          ? "image/jpeg"
          : undefined;

      bru.visualize("html", {
        name: "Foto CED",
        content: imageMimeType
          ? `<div style="text-align:center"><img alt="Foto CED" src="data:${imageMimeType};base64,${photoBase64}" style="max-width:100%;max-height:80vh;object-fit:contain"></div>`
          : "<p>Formato immagine non riconosciuto. Sono supportati JPEG e PNG.</p>"
      });
    }
  }
}
