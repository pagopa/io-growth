{
  "name": "ced-card-request-be",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "files": [
    "dist/*"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "build:watch": "tsc -w",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm lint:check --fix",
    "lint:check": "eslint .",
    "start": "node dist/main.js",
    "run:dev": "tsx --env-file=.env --watch src/main.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate": "orval"
  },
  "dependencies": {
    "@azure/cosmos": "^4.9.3",
    "@azure/identity": "^4.13.1",
    "@azure/storage-blob": "^12.31.0",
    "@pagopa/io-core-adapter-fastify": "workspace:^",
    "@standard-schema/spec": "^1.1.0",
    "@pagopa/io-core-adapter-fims": "workspace:^",
    "@pagopa/io-core-adapter-inps-ced": "workspace:^",
    "@pagopa/io-core-adapter-modi": "workspace:^",
    "@pagopa/io-core-adapter-redis": "workspace:^",
    "@pagopa/io-core-adapter-tracing": "workspace:^",
    "@pagopa/io-core-domain": "workspace:^",
    "fastify": "catalog:",
    "neverthrow": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pagopa/eslint-config": "catalog:",
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "orval": "catalog:",
    "tsx": "^4.19.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
