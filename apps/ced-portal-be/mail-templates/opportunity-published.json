{
  "TemplateContent": {
    "Html": "<!doctype html>\n<html lang=\"it\" dir=\"auto\" xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:v=\"urn:schemas-microsoft-com:vml\"\n  xmlns:o=\"urn:schemas-microsoft-com:office:office\">\n\n<head>\n  <title>Opportunità pubblicata</title>\n  <!--[if !mso]><!-->\n  <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n  <!--<![endif]-->\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <style type=\"text/css\">\n    #outlook a {\n      padding: 0;\n    }\n\n    body {\n      margin: 0;\n      padding: 0;\n      -webkit-text-size-adjust: 100%;\n      -ms-text-size-adjust: 100%;\n    }\n\n    table,\n    td {\n      border-collapse: collapse;\n      mso-table-lspace: 0pt;\n      mso-table-rspace: 0pt;\n    }\n\n    img {\n      border: 0;\n      height: auto;\n      line-height: 100%;\n      outline: none;\n      text-decoration: none;\n      -ms-interpolation-mode: bicubic;\n    }\n\n    p {\n      display: block;\n      margin: 13px 0;\n    }\n  </style>\n  <!--[if mso]>\n    <noscript>\n    <xml>\n    <o:OfficeDocumentSettings>\n      <o:AllowPNG/>\n      <o:PixelsPerInch>96</o:PixelsPerInch>\n    </o:OfficeDocumentSettings>\n    </xml>\n    </noscript>\n    <![endif]-->\n  <!--[if lte mso 11]>\n    <style type=\"text/css\">\n      .mj-outlook-group-fix { width:100% !important; }\n    </style>\n    <![endif]-->\n\n  <!--[if !mso]><!-->\n  <link href=\"https://selfcare.pagopa.it/assets/font/selfhostedfonts.css\" rel=\"stylesheet\" type=\"text/css\">\n  <style type=\"text/css\">\n    @import url(https://selfcare.pagopa.it/assets/font/selfhostedfonts.css);\n  </style>\n  <!--<![endif]-->\n\n\n\n  <style type=\"text/css\">\n    @media only screen and (min-width:480px) {\n      .mj-column-per-100 {\n        width: 100% !important;\n        max-width: 100%;\n      }\n    }\n  </style>\n  <style media=\"screen and (min-width:480px)\">\n    .moz-text-html .mj-column-per-100 {\n      width: 100% !important;\n      max-width: 100%;\n    }\n  </style>\n\n\n\n\n  <style type=\"text/css\">\n    @media only screen and (max-width:479px) {\n      table.mj-full-width-mobile {\n        width: 100% !important;\n      }\n\n      td.mj-full-width-mobile {\n        width: auto !important;\n      }\n    }\n  </style>\n\n  <style type=\"text/css\">\n    :root {\n      color-scheme: light dark;\n      supported-color-schemes: light dark;\n    }\n\n    body,\n    .mail-body {\n      background-color: #FFFFFF;\n    }\n\n    .header {\n      background-color: #FFFFFF;\n      /* border-top: 8px solid #0073E6; */\n    }\n\n    .section {\n      background-color: #FFFFFF;\n    }\n\n    .title div {\n      /* Text Primary */\n      color: #17324D !important;\n    }\n\n    .text div {\n      /* Text Primary */\n      color: #17324D !important;\n    }\n\n    .text-secondary,\n    .text-secondary div {\n      /* Text Secondary */\n      color: #5C6F82 !important;\n    }\n\n    p {\n      margin-top: 12px;\n      margin-bottom: 12px;\n    }\n\n    .text-secondary a,\n    .text a {\n      color: #0073E6 !important;\n    }\n\n    .link {\n      color: #0073E6 !important;\n    }\n\n    .divider p {\n      border-color: #E3E7EB !important;\n    }\n\n    /* Message Preview Block */\n\n    .message-preview {\n      background-color: #FAFAFA;\n    }\n\n    @media (prefers-color-scheme: light) {\n\n      .dark-img,\n      [data-ogsc] .dark-img {\n        display: none !important;\n        mso-hide: all !important;\n      }\n\n      .light-img,\n      [data-ogsc] .light-img {\n        display: block;\n        display: block !important;\n      }\n    }\n\n    @media (min-width: 600px) {\n\n      .mobile {\n        display: none;\n      }\n\n      .desktop {\n        display: block;\n      }\n    }\n\n    @media (prefers-color-scheme: dark) {\n\n      body,\n      .mail-body {\n        background-color: #323232;\n      }\n\n      .header {\n        background-color: #323232;\n        /* border-top: 8px solid #3da2ff; */\n      }\n\n      .section {\n        background-color: #323232;\n      }\n\n      .message-preview {\n        background-color: #424242;\n      }\n\n      .divider p {\n        border-color: #757575 !important;\n      }\n\n      .title div {\n        color: #ffffff !important;\n      }\n\n      .text div {\n        color: #ffffff !important;\n      }\n\n      .text-secondary,\n      .text-secondary div {\n        /* Gray-200 */\n        color: #E0E0E0 !important;\n      }\n\n      .text-secondary a,\n      .text a {\n        color: #3da2ff !important;\n      }\n\n      .link {\n        color: #3da2ff !important;\n      }\n\n      .cta table td,\n      .cta table td>a {\n        background-color: #3da2ff !important;\n      }\n\n      /* IMAGES */\n      /* Source: https://www.litmus.com/blog/the-ultimate-guide-to-dark-mode-for-email-marketers/ */\n\n      .dark-img,\n      [data-ogsc] .dark-img {\n        display: block !important;\n        overflow: visible !important;\n        float: none !important;\n        line-height: auto !important;\n        margin-top: 0px !important;\n        visibility: inherit !important;\n      }\n\n      .light-img,\n      [data-ogsc] .light-img {\n        display: none;\n        display: none !important;\n        mso-hide: all !important;\n      }\n    }\n  </style>\n  <meta http-equiv=\"Content-Type\" content=\"text/html\" charset=\"UTF-8\" />\n  <meta name=\"color-scheme\" content=\"light dark\" />\n  <meta name=\"supported-color-schemes\" content=\"light dark\" />\n</head>\n\n<body style=\"word-spacing:normal;\">\n\n\n  <div aria-label=\"Opportunità pubblicata\" aria-roledescription=\"email\" class=\"mail-body\" style=\"\" role=\"article\"\n    lang=\"it\" dir=\"auto\">\n\n\n    <!--[if mso | IE]><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"\" role=\"presentation\" style=\"width:600px;\" width=\"600\" ><tr><td style=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\"><![endif]-->\n\n\n    <div style=\"margin:0px auto;max-width:600px;\">\n\n      <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"width:100%;\">\n        <tbody>\n          <tr>\n            <td\n              style=\"direction:ltr;font-size:0px;padding:20px 0;padding-left:20px;padding-right:20px;text-align:center;\">\n              <!--[if mso | IE]><table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><![endif]-->\n\n              <!-- PagoPA Logo -->\n              <!--[if mso | IE]><tr><td class=\"header-outlook\" width=\"600px\" ><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"header-outlook\" role=\"presentation\" style=\"width:560px;\" width=\"560\" ><tr><td style=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\"><![endif]-->\n\n\n              <div class=\"header\" style=\"margin:0px auto;max-width:560px;\">\n\n                <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\"\n                  style=\"width:100%;\">\n                  <tbody>\n                    <tr>\n                      <td\n                        style=\"direction:ltr;font-size:0px;padding:20px 0;padding-bottom:0px;padding-top:0px;text-align:center;\">\n                        <!--[if mso | IE]><table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr><td class=\"\" style=\"vertical-align:top;width:560px;\" ><![endif]-->\n\n                        <div class=\"mj-column-per-100 mj-outlook-group-fix\"\n                          style=\"font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;\">\n\n                          <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\"\n                            style=\"vertical-align:top;\" width=\"100%\">\n                            <tbody>\n\n                              <tr>\n                                <td align=\"left\" class=\"light-img\"\n                                  style=\"font-size:0px;padding:10px 25px;padding-left:0;word-break:break-word;\">\n\n                                  <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\"\n                                    style=\"border-collapse:collapse;border-spacing:0px;\">\n                                    <tbody>\n                                      <tr>\n                                        <td style=\"width:36px;\">\n\n                                          <img alt=\"\"\n                                            src=\"https://raw.githubusercontent.com/pagopa/io-growth/main/packages/io-core-email-templates/src/assets/logo_pagopa.png\"\n                                            style=\"border:0;display:block;outline:none;text-decoration:none;height:auto;width:100%;font-size:13px;\"\n                                            width=\"36\" height=\"auto\" />\n\n                                        </td>\n                                      </tr>\n                                    </tbody>\n                                  </table>\n\n                                </td>\n                              </tr>\n                              <div class=\"dark-img\" style=\"mso-hide: all; display: none; padding: 10px 0px\">\n                                <img\n                                  src=\"https://raw.githubusercontent.com/pagopa/io-growth/main/packages/io-core-email-templates/src/assets/logo_pagopa.png\"\n                                  width=\"36px\" class=\"dark-img\" style=\"display: none\" />\n                              </div>\n                            </tbody>\n                          </table>\n\n                        </div>\n\n                        <!--[if mso | IE]></td></tr></table><![endif]-->\n                      </td>\n                    </tr>\n                  </tbody>\n                </table>\n\n              </div>\n\n\n              <!--[if mso | IE]></td></tr></table></td></tr><tr><td class=\"section-outlook\" width=\"600px\" ><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"section-outlook\" role=\"presentation\" style=\"width:560px;\" width=\"560\" ><tr><td style=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\"><![endif]-->\n\n\n              <div class=\"section\" style=\"margin:0px auto;max-width:560px;\">\n\n                <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\"\n                  style=\"width:100%;\">\n                  <tbody>\n                    <tr>\n                      <td\n                        style=\"direction:ltr;font-size:0px;padding:20px 0;padding-bottom:0px;padding-top:0px;text-align:center;\">\n                        <!--[if mso | IE]><table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr><td class=\"\" style=\"vertical-align:top;width:560px;\" ><![endif]-->\n\n                        <div class=\"mj-column-per-100 mj-outlook-group-fix\"\n                          style=\"font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;\">\n\n                          <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\"\n                            style=\"vertical-align:top;\" width=\"100%\">\n                            <tbody>\n                              <!-- Title & Main Message -->\n                              <tr>\n                                <td align=\"left\" class=\"title\"\n                                  style=\"font-size:0px;padding:10px 25px;padding-top:24px;padding-right:0px;padding-bottom:0px;padding-left:0px;word-break:break-word;\">\n\n                                  <div\n                                    style=\"font-family:Titillium Web, system-ui, sans-serif;font-size:13px;font-weight:bold;line-height:1;text-align:left;color:#17324D;\">\n                                    <!-- H4 Desktop (from MUI Italia)-->\n                                    <h1 style=\"font-size: 32px; line-height: 40px; margin: 0\">\n                                      Opportunità pubblicata\n                                    </h1>\n                                  </div>\n\n                                </td>\n                              </tr>\n\n                              <tr>\n                                <td align=\"left\" class=\"text\"\n                                  style=\"font-size:0px;padding:10px 25px;padding-top:4px;padding-right:0px;padding-left:0px;word-break:break-word;\">\n\n                                  <div\n                                    style=\"font-family:Titillium Web, system-ui, sans-serif;font-size:16px;font-weight:regular;line-height:24px;text-align:left;color:#17324D;\">\n                                    <!-- Body 1 Desktop (from MUI Italia)-->\n                                    <p>Ciao,</p>\n\n                                    <p>\n                                      abbiamo <strong>pubblicato</strong> l&rsquo;opportunità\n                                      <strong>{{opportunityName}}</strong>.\n                                    </p>\n\n                                    <p>L&rsquo;opportunità è ora disponibile su IO e sul sito del Dipartimento.</p>\n\n                                    <p>\n                                      Per consultare o gestire le tue opportunità, accedi ad\n                                      <a href=\"#\">Area Riservata</a>\n                                      e seleziona il prodotto Carta Europea della Disabilità.\n                                    </p>\n\n                                    <p>\n                                      Se hai bisogno di supporto con le opportunità, consulta il\n                                      <a href=\"#\">manuale operativo</a>.\n                                    </p>\n\n                                    <p>\n                                      Per problemi tecnici nell&rsquo;uso della piattaforma\n                                      <a href=\"#\">vai nel portale</a>\n                                      e apri una richiesta.\n                                    </p>\n\n                                    <p>A presto,</p>\n\n                                    <p>Il Dipartimento per le politiche in favore delle persone con disabilità</p>\n                                  </div>\n\n                                </td>\n                              </tr>\n\n                            </tbody>\n                          </table>\n\n                        </div>\n\n                        <!--[if mso | IE]></td></tr></table><![endif]-->\n                      </td>\n                    </tr>\n                  </tbody>\n                </table>\n\n              </div>\n\n\n              <!--[if mso | IE]></td></tr></table></td></tr><![endif]-->\n              <!-- Divider -->\n              <!--[if mso | IE]><tr><td class=\"section-outlook\" width=\"600px\" ><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"section-outlook\" role=\"presentation\" style=\"width:560px;\" width=\"560\" ><tr><td style=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\"><![endif]-->\n\n\n              <div class=\"section\" style=\"margin:0px auto;max-width:560px;\">\n\n                <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\"\n                  style=\"width:100%;\">\n                  <tbody>\n                    <tr>\n                      <td\n                        style=\"direction:ltr;font-size:0px;padding:20px 0;padding-bottom:0px;padding-top:0px;text-align:center;\">\n                        <!--[if mso | IE]><table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr><td class=\"\" style=\"vertical-align:top;width:560px;\" ><![endif]-->\n\n                        <div class=\"mj-column-per-100 mj-outlook-group-fix\"\n                          style=\"font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;\">\n\n                          <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\"\n                            style=\"vertical-align:top;\" width=\"100%\">\n                            <tbody>\n\n                              <tr>\n                                <td align=\"center\" class=\"divider\"\n                                  style=\"font-size:0px;padding:0px;padding-top:16px;padding-bottom:16px;word-break:break-word;\">\n\n                                  <p style=\"border-top:solid 1px #E3E7EB;font-size:1px;margin:0px auto;width:100%;\">\n                                  </p>\n\n                                  <!--[if mso | IE]><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-top:solid 1px #E3E7EB;font-size:1px;margin:0px auto;width:560px;\" role=\"presentation\" width=\"560px\" ><tr><td style=\"height:0;line-height:0;\"> &nbsp;\n</td></tr></table><![endif]-->\n\n\n                                </td>\n                              </tr>\n\n                            </tbody>\n                          </table>\n\n                        </div>\n\n                        <!--[if mso | IE]></td></tr></table><![endif]-->\n                      </td>\n                    </tr>\n                  </tbody>\n                </table>\n\n              </div>\n\n\n              <!--[if mso | IE]></td></tr></table></td></tr><![endif]-->\n              <!-- Footer -->\n              <!--[if mso | IE]><tr><td class=\"section-outlook\" width=\"600px\" ><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"section-outlook\" role=\"presentation\" style=\"width:560px;\" width=\"560\" ><tr><td style=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\"><![endif]-->\n\n\n              <div class=\"section\" style=\"margin:0px auto;max-width:560px;\">\n\n                <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\"\n                  style=\"width:100%;\">\n                  <tbody>\n                    <tr>\n                      <td style=\"direction:ltr;font-size:0px;padding:0px;text-align:center;\">\n                        <!--[if mso | IE]><table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr><td class=\"\" style=\"vertical-align:top;width:560px;\" ><![endif]-->\n\n                        <div class=\"mj-column-per-100 mj-outlook-group-fix\"\n                          style=\"font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;\">\n\n                          <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\"\n                            style=\"vertical-align:top;\" width=\"100%\">\n                            <tbody>\n\n                              <tr>\n                                <td align=\"left\" style=\"font-size:0px;padding:0px;word-break:break-word;\">\n\n                                  <div\n                                    style=\"font-family:Titillium Web, system-ui, sans-serif;font-size:14px;font-weight:regular;line-height:20px;text-align:left;color:#A2ADB8;\">\n                                    <p>Ricevi questo messaggio per il tuo coinvolgimento nell&rsquo;iniziativa Carta\n                                      Europea della Disabilità.</p>\n                                  </div>\n\n                                </td>\n                              </tr>\n\n                            </tbody>\n                          </table>\n\n                        </div>\n\n                        <!--[if mso | IE]></td></tr></table><![endif]-->\n                      </td>\n                    </tr>\n                  </tbody>\n                </table>\n\n              </div>\n\n\n              <!--[if mso | IE]></td></tr></table></td></tr></table><![endif]-->\n            </td>\n          </tr>\n        </tbody>\n      </table>\n\n    </div>\n\n\n    <!--[if mso | IE]></td></tr></table><![endif]-->\n\n\n  </div>\n\n</body>\n\n</html>",
    "Subject": "Opportunità pubblicata: {{opportunityName}}",
    "Text": "Ciao,\n\nabbiamo pubblicato l’opportunità {{opportunityName}}.\n\nL’opportunità è ora disponibile su IO e sul sito del Dipartimento.\n\nPer consultare o gestire le tue opportunità, accedi ad Area Riservata e seleziona il prodotto Carta Europea della Disabilità.\n\nSe hai bisogno di supporto con le opportunità, consulta il manuale operativo.\n\nPer problemi tecnici nell’uso della piattaforma vai nel portale e apri una richiesta.\n\nA presto,\n\nIl Dipartimento per le politiche in favore delle persone con disabilità.\n\nRicevi questo messaggio per il tuo coinvolgimento nell’iniziativa Carta Europea della Disabilità."
  },
  "TemplateName": "opportunity-published"
}
