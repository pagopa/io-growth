meta {
  name: Create the authenticated operator profile
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/operator/profile
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  profile: {"displayName":"Operatore Demo","place":{"type":"online","name":"Sportello remoto","website":{"url":"https://example.org"},"supportContacts":[{"type":"email","value":"support@example.org"}]}}
  logo: @file(/path/to/logo.png)
  image: @file(/path/to/image.png)
}
