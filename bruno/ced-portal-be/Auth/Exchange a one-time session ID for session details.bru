meta {
  name: Exchange a one-time session ID for session details
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/authorize?id={{sessionId}}
  body: none
  auth: none
}

params:query {
  id: {{sessionId}}
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("sessionToken", res.body.session_token, { persist: false });
  }
}
