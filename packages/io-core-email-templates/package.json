{
  "name": "@pagopa/io-core-email-templates",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "generate": "node scripts/generate-templates.mjs",
    "build": "pnpm clean && tsc",
