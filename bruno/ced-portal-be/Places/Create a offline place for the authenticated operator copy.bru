meta {
  name: Create a offline place for the authenticated operator copy
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/operator/places
  body: json
  auth: inherit
}

body:json {
  {
    "type": "offline",
    "name": "place offline",
    "address": {
      "street": "Via Roma 1",
      "city": "Roma",
      "state": "RM",
      "postalCode": "00100",
      "country": "IT"
    },
    "supportContacts": [
      {
        "type": "website",
        "value": "https://example.org/support"
      }
    ]
  }
}
