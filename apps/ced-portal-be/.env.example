# Copy this file to .env and fill in the values for local development.
# .env is gitignored and should never be committed.

# Application
HOST=0.0.0.0
PORT=8080
CED_PORTAL_FE_BASE_URL=

# Authorization — comma-separated fiscal codes that identify admin and test_user roles (leave empty to disable)
ADMIN_FISCAL_CODES=
TEST_USER_FISCAL_CODES=

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=6432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSL=false

# Redis
REDIS_ENDPOINT=localhost:6379
REDIS_TLS=false

#AR
AR_ENDPOINT=
AR_API_KEY=
CED_PRODUCT_ID=

#Telemetry
TELEMETRY_SERVICE_NAME=ced-portal-be-local
