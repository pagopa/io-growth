      "sesso": "M",
      "statoNascita": "ITALIA",
      "comuneNascita": "Roma",
      "siglaProvinciaNascita": "RM",
      "idCittadinanza": 0
    },
    "recapito": {
      "pressoDenominazione": "Mario Rossi",
      "siglaProvincia": "RM",
      "descrizioneComune": "Roma",
      "cap": "00100",
      "indirizzo": "Via di Test",
      "civico": "1"
    }
  }
}
