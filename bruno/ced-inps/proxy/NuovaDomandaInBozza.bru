meta {
  name: NuovaDomandaInBozza
  type: http
  seq: 2
}

post {
  url: {{inpsProxyBaseUrl}}/Domanda/NuovaDomandaInBozza
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  INPS-Identity-UserId: {{fiscalCode}}
  INPS-Identity-CodiceUfficio: {{inpsOfficeCode}}
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "informativaPrivacy": true,
    "anagrafica": {
      "codiceFiscale": "{{fiscalCode}}",
      "nome": "Mario",
      "cognome": "Rossi",
