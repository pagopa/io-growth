@startuml Draft Request Sequence Diagram

actor "FE (User App)" as FE
participant "BFF (Our System)" as BFF
database "Local DB\n(partitionKey, idLavorazione,\nstate, pendingStep, steps{})" as DB
box "INPS Services (ModI P3)" #LightBlue
  participant "MS INPS\n(GestioneDomandaCED)" as INPS
end box

title 2. New Application Data Submission (NuovaDomandaInBozza)

FE -> BFF: POST /request (Dati completi)\n<<Header: Idempotency-Key = clientKey>>

BFF -> DB: Read Record R (partitionKey = CF)
DB --> BFF: R

alt Replay/retry of the SAME intent (R.steps.draft.clientRequestId == clientKey)
    alt R.steps.draft.status == COMPLETED
        note right of BFF: True replay, no INPS call.
        BFF --> FE: 200 (idLavorazione, Next step: Photo)
    else status PENDING/FAILED
        note right of BFF: Retry reuses R.steps.draft.inpsIdempotencyKey (IK_DRAFT).
    end

else NEW intent (new clientKey or no draft step)
    BFF -> BFF: Generate IK_DRAFT (UUID)
    note right of BFF: Cascade rule: reset photo + confirm steps,\nclear idLavorazione (a new draft yields a new one).

    == Write 1: intent record ==
    BFF -> DB: UPSERT R (steps.draft={clientRequestId:clientKey,\ninpsIdempotencyKey:IK_DRAFT, status:PENDING},\npendingStep:DRAFT, idLavorazione:NULL) <<If-Match>>
    alt DB Write 1 FAILURE
        DB --> BFF: ERROR
        BFF --> FE: 503 Service Unavailable
    end
    DB --> BFF: OK
end

BFF -> INPS: NuovaDomandaInBozza(Dati completi)\n<<Header: Idempotency-Key = IK_DRAFT>>

alt INPS Success (HTTP 200 OK)
    INPS --> BFF: idLavorazione (X)

    == Write 2: outcome ==
    BFF -> DB: UPDATE R (idLavorazione=X, steps.draft.status=COMPLETED,\nstate=READY_FOR_PHOTO_UPLOAD, pendingStep=NULL) <<If-Match>>

    alt DB Update SUCCESS
        DB --> BFF: OK
        BFF --> FE: 200 (idLavorazione=X, Next step: Photo required)
    else DB Update FAILURE (***INCONSISTENCY POINT***)
        DB --> BFF: ERROR (Timeout)
        note right of BFF: INPS has draft X; local still PENDING/DRAFT.\nReconciliation on next /status realigns from esitoCheck=20.
        BFF --> FE: 500 System Error
    end

else INPS Validation Failure (HTTP 400)
    INPS --> BFF: Validation Error Code (200-315)
    BFF -> DB: UPDATE R (steps.draft.status=FAILED, lastErrorCode, pendingStep=NULL)
    DB --> BFF: OK
    BFF --> FE: 400 Validation Error (code + description)

else INPS System Error (HTTP 500)
    INPS --> BFF: Error Code 100
    note right of BFF: Keep steps.draft.status=PENDING so a retry reuses IK_DRAFT.
    BFF --> FE: 500 System Error
end
@enduml
