# Copy this file to .env and fill in the values for local development.
# .env is gitignored and should never be committed.

# Application
HOST=0.0.0.0
PORT=8080
CED_PORTAL_FE_BASE_URL=

# Authorization — comma-separated fiscal codes that identify admin role (leave empty to disable)
ADMIN_FISCAL_CODES=

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=6432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSL=false

# Redis
REDIS_ENDPOINT=localhost:6379
REDIS_TLS=false

#AR
AR_ENDPOINT=
AR_API_KEY=
CED_PRODUCT_ID=

# FIMS citizen auth
BASE_URL=http://localhost:8080
FIMS_CLIENT_ID=
FIMS_CLIENT_SECRET=
FIMS_ISSUER_URL=
FIMS_REDIRECT_URL=
FIMS_SCOPE=
FIMS_AUDIT_BLOB_URI=
FIMS_AUDIT_CONTAINER=
PAGOPA_IDP_KEYS_BASE_URL=

# Azure Storage (Azurite per dev locale — bypassa DefaultAzureCredential su HTTP)
# In produzione non impostare: verrà usato DefaultAzureCredential con FIMS_AUDIT_BLOB_URI
AZURE_STORAGE_CONNECTION_STRING=
