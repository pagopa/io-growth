meta {
  name: Assertion Consumer Service callback
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/acs?token={{tokenAdminTest}}
  body: none
  auth: none
}

params:query {
  token: {{tokenAdminTest}}
  ~token: {{token}}
  ~token: {{tokenAdmin}}
  ~token: {{tokenTest}}
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("sessionToken", res.body.session_token, { persist: false });
  
    }
}
