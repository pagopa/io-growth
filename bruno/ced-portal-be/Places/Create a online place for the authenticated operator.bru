meta {
  name: Create a online place for the authenticated operator
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/operator/places
  body: json
  auth: inherit
}

body:json {
  {
    "type": "online",
    "name": "place online",
    "website": {
      "url":"http://example.com"
    },
    "supportContacts": [
      {
        "type": "website",
        "value": "https://example.org/support"
      }
    ]
  }
}
