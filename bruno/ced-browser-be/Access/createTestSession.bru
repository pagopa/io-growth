meta {
  name: Create a test session (test users only)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/test-session
  body: json
  auth: none
}

body:json {
  {
    "fiscalCode": "FISCAL_CODE",
    "familyName": "test",
    "givenName": "test"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("sessionToken", res.body.token, { persist: false });

    }
}
