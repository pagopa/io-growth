{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "generate": {
      "inputs": [
        "openapi/**/*.yaml",
        "orval.config.ts",
        "$TURBO_ROOT$/apps/ced-card-request-be/openapi/exposed/openapi.yaml"
      ],
      "outputs": [
        "src/adapters/inbound/fastify/contracts/**",
        "src/core/api/generated/**",
        "src/generated/**"
      ]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["src/**", "tsconfig.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "migrate:dev": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "migrate:prod": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "run:dev": {
      "dependsOn": ["^build", "generate"],
      "persistent": true,
      "cache": false
    },
    "typecheck": {
      "inputs": [
        "src/**/*.ts",
        "package.json",
        "tsconfig.json",
        "!vitest.config.*"
      ],
      "outputs": [],
      "dependsOn": ["^build", "^typecheck", "generate"]
    },
    "lint": {
      "inputs": ["src/**/*.ts"]
    },
    "lint:check": {
      "inputs": ["src/**/*.ts"]
    },
    "format": {},
    "format:check": {},
    "test": {
      "dependsOn": ["^build", "generate"],
      "inputs": [],
      "outputLogs": "full"
    },
    "test:coverage": {
      "dependsOn": ["^build", "generate"],
      "inputs": [],
      "outputs": ["coverage"],
      "outputLogs": "full"
    }
  }
}
