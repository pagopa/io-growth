# Copy this file to .env and fill in the values for local development.
# .env is gitignored and should never be committed.

# Application
HOST=0.0.0.0
PORT=8080

# Test users (comma-separated SHA-256 hashed fiscal codes; leave empty to disable /test-session)
TEST_USERS=

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=6432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSL=false

# Redis
REDIS_ENDPOINT=localhost:6379
REDIS_TLS=false
