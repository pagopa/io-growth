@startuml Upload Documentation and Confirm Sequence Diagram

actor "FE (User App)" as FE
participant "BFF (Our System)" as BFF
database "Local DB\n(partitionKey, idLavorazione,\nstate, pendingStep, steps{})" as DB
box "INPS Services (PDND)" #LightBlue
  participant "MS INPS\n(GestioneDomandaCED)" as INPS
end box

title 4. Confirmation Submission (ConfermaDomanda)

FE -> BFF: POST /confirm (idLavorazione, Ulteriore Documentazione OPTIONAL)\n<<Header: Idempotency-Key = clientKey>>

BFF -> DB: Read Record R (partitionKey = CF)
DB --> BFF: R
BFF -> BFF: Verify R.idLavorazione == idLavorazione (ownership)

alt Replay/retry of the SAME intent (R.steps.confirm.clientRequestId == clientKey)
    alt R.steps.confirm.status == COMPLETED
        note right of BFF: True replay, no INPS call.
        BFF --> FE: 200 (Application acquired)
    else status PENDING/FAILED
        note right of BFF: Retry reuses R.steps.confirm.inpsIdempotencyKey (IK_CONFIRM).
    end

else NEW intent (new clientKey)
    BFF -> BFF: Generate IK_CONFIRM (UUID)
    note right of BFF: Once ACQUIRED, a different key yields INPS 400/115.

    == Write 1: intent record ==
    BFF -> DB: UPDATE R (steps.confirm={clientRequestId:clientKey,\ninpsIdempotencyKey:IK_CONFIRM, status:PENDING}, pendingStep:CONFIRM) <<If-Match>>
    alt DB Write 1 FAILURE
        DB --> BFF: ERROR
        BFF --> FE: 503 Service Unavailable
    end
    DB --> BFF: OK
end

BFF -> INPS: ConfermaDomanda(idLavorazione, Dati aggiuntivi)\n<<Header: Idempotency-Key = IK_CONFIRM>>

alt INPS Success (HTTP 200 OK)
    INPS --> BFF: idLavorazione (X)

    == Write 2: outcome ==
    BFF -> DB: UPDATE R (steps.confirm.status=COMPLETED, state=ACQUIRED, pendingStep=NULL) <<If-Match>>

    alt DB Update SUCCESS
        DB --> BFF: OK
        BFF --> FE: 200 (Application acquired)
    else DB Update FAILURE (***INCONSISTENCY POINT***)
        DB --> BFF: ERROR (Timeout)
        note right of BFF: INPS acquired (esitoCheck=40); local still PENDING.\nReconciliation on next /status realigns.
        BFF --> FE: 500 System Error
    end

else INPS Failure (HTTP 400)
    INPS --> BFF: Error Code (400-409 docs, 114 missing photo, 115 state)
    BFF -> DB: UPDATE R (steps.confirm.status=FAILED, lastErrorCode, pendingStep=NULL)
    DB --> BFF: OK
    BFF --> FE: 400 Validation Error (code + description)

else INPS System Error (HTTP 500)
    INPS --> BFF: Error Code 100
    note right of BFF: Keep steps.confirm.status=PENDING so a retry reuses IK_CONFIRM.
    BFF --> FE: 500 System Error
end
@enduml
