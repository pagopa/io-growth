meta {
  name: ConfermaDomanda
  type: http
  seq: 4
}

post {
  url: {{inpsProxyBaseUrl}}/Domanda/ConfermaDomanda
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  INPS-Identity-UserId: {{fiscalCode}}
  INPS-Identity-CodiceUfficio: {{inpsOfficeCode}}
  Idempotency-Key: {{$guid}}
  Accept-Encoding: Identity
}

body:json {
  {
    "idLavorazione": "{{processingId}}",
    "codiceFiscale": "{{fiscalCode}}"
  }
}
