meta {
  name: CheckDomanda
  type: http
  seq: 1
}

post {
  url: {{inpsProxyBaseUrl}}/Domanda/CheckDomanda
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  INPS-Identity-UserId: {{fiscalCode}}
  INPS-Identity-CodiceUfficio: {{inpsOfficeCode}}
}

body:json {
  {
    "codiceFiscale": "{{fiscalCode}}"
  }
}

docs {
  The Postman collection contained one saved 400 response for error code 107,
  "Soggetto deceduto". Personal data and the response trace ID were removed.
}
