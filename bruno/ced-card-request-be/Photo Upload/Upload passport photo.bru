meta {
  name: Upload passport photo
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/image
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "idLavorazione": "REPLACE_WITH_ID_LAVORAZIONE",
    "fotoCED": "BASE_64_FILE",
    "informativaFoto": true
  }
}
