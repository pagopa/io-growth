log_format debug_upstream
    '$remote_addr - [$time_iso8601] "$request" '
    'status=$status bytes=$body_bytes_sent '
    'upstream_status=$upstream_status '
    'upstream_addr=$upstream_addr '
    'upstream_response_time=$upstream_response_time '
    'req_content_type="$http_content_type" '
    'req_authorization="$http_authorization" '
    'req_agid_jwt="$http_agid_jwt_signature" '
    'req_inps_user="$http_inps_identity_userid" '
    'req_inps_ufficio="$http_inps_identity_codiceufficio" '
    'req_digest="$http_digest" '
    'resp_content_type="$upstream_http_content_type" '
    'resp_www_authenticate="$upstream_http_www_authenticate"';

server {
    listen 8080;
    server_name _;

    location /healthz {
        access_log off;
        return 200 'ok';
        add_header Content-Type text/plain;
    }

    location / {
        access_log /dev/stdout debug_upstream;

        proxy_pass                  https://${INPS_UPSTREAM};
        proxy_set_header            Host ${INPS_UPSTREAM};

        # TLS to upstream
        proxy_ssl_server_name       on;
        proxy_ssl_protocols         TLSv1.2 TLSv1.3;
        proxy_ssl_verify            on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

        proxy_http_version          1.1;
        proxy_set_header            Connection "";

        # Preserve all incoming headers unchanged (Agid-JWT-Signature,
        # INPS-Identity-UserId, INPS-Identity-CodiceUfficio, Digest, etc.)
        proxy_pass_request_headers  on;

        # Generous timeout for INPS API round-trips
        proxy_connect_timeout       10s;
        proxy_read_timeout          60s;
        proxy_send_timeout          60s;
    }
}
