# Copy this file to .env and fill in the values for local development.
# .env is gitignored and should never be committed.

# Application
HOST=0.0.0.0
PORT=8080
CED_PORTAL_FE_BASE_URL=

# Authorization — comma-separated fiscal codes that identify admin role (leave empty to disable)
ADMIN_FISCAL_CODES=
# Authorization — comma-separated fiscal codes that identify admin role for the test environment (leave empty to disable)
ADMIN_FISCAL_CODES_TEST=
# Authorization — comma-separated fiscal codes routed to the test environment (leave empty to disable)
OPERATORS_FISCAL_CODES_TEST=

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=6432
POSTGRES_DB=
# Test environment database name (falls back to POSTGRES_DB when unset)
POSTGRES_DB_TEST=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSL=false
POSTGRES_MAX_CONNECTIONS=10

# Redis
REDIS_ENDPOINT=localhost:6379
REDIS_TLS=false
# Client ID for Redis Entra ID auth (leave empty to use access-key auth)
AZURE_CLIENT_ID=

#AR
AR_ENDPOINT=
AR_API_KEY=
# AR (Area Riservata) — test instance
AR_ENDPOINT_TEST=
AR_API_KEY_TEST=
CED_PRODUCT_ID=

# Assets blob storage
# Local devcontainer: use Azurite's shared-key connection string.
ASSETS_STORAGE_CONNECTION_STRING=
# Production: leave ASSETS_STORAGE_CONNECTION_STRING empty and use the endpoint with the managed identity.
ASSETS_STORAGE_BLOB_ENDPOINT=
ASSETS_STORAGE_CONTAINER_LOGOS=logos
ASSETS_STORAGE_CONTAINER_IMAGES=images

# One mail
EMAIL_FROM_ADDRESS=
ONE_MAIL_API_KEY=
ONE_MAIL_BASE_URL=

#Telemetry
TELEMETRY_SERVICE_NAME=ced-portal-be-local
