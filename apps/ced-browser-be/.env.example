# Copy this file to .env and fill in the values for local development.
# .env is gitignored and should never be committed.

# Application
BASE_URL=http://localhost:8080
HOST=0.0.0.0
PORT=8080

# FIMS / OIDC
FIMS_CLIENT_ID=
FIMS_CLIENT_SECRET=
FIMS_ISSUER_URL=
FIMS_REDIRECT_URL=http://localhost:8080/callback
FIMS_SCOPE=openid profile
PAGOPA_IDP_KEYS_BASE_URL=

# FIMS Audit (Azure Blob Storage)
FIMS_AUDIT_BLOB_URI=
FIMS_AUDIT_CONTAINER=

# Test users (comma-separated SHA-256 hashed fiscal codes; leave empty to disable /test-session)
TEST_USERS=

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=6432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
