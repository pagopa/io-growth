meta {
  name: Delete an opportunity for the authenticated operator
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/operator/opportunities/:opportunityId/delete
  body: json
  auth: inherit
}

params:path {
  opportunityId: an-opportunity-id
}

body:json {
  {
    "deletionMessage": "The opportunity is no longer available"
  }
}
